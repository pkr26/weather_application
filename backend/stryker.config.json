{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "reporters": [
    "clear-text",
    "html",
    "progress",
    "json"
  ],
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/env.ts",
    "!src/logger.ts",
    "!src/i18n/packs/**"
  ],
  "coverageAnalysis": "off",
  "timeoutMS": 15000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 98,
    "low": 98,
    "break": 98
  }
}
