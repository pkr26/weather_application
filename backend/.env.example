# --- Server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# --- Google Maps Platform Weather API ---
# Create at https://console.cloud.google.com (enable the Weather API).
# This key is server-side only — never ship it in the Android app.
WEATHER_API_KEY=
# Only needed for Google's public demo key; leave empty for your own key.
WEATHER_API_REFERER=

# --- Security ---
# Optional shared bearer token for the whole API surface. Empty = open (the
# Android client sends nothing). When set, every route except /health
# requires the same value as the X-Api-Token header — use it when the
# backend is publicly reachable so strangers cannot burn your weather quota.
# Must be at least 16 characters when set (config validation refuses
# shorter values — a brute-forceable token is a gate in name only).
# API_TOKEN=
# Registry records not updated within this many days are pruned at load and
# reclaimed on write when the registry cap is hit.
# DEVICE_MAX_AGE_DAYS=365
# Browser origins allowed to call the API (comma-separated). Leave empty to
# disable CORS entirely — the Android client is not a browser and needs none.
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# Proxy trust for client-IP / rate-limit identity:
#   (empty) trust loopback proxies only — safe default, X-Forwarded-For
#           from direct internet clients is ignored
#   1        trust exactly one reverse proxy / load balancer (deploy behind one)
#   0        never trust proxy headers
# TRUST_PROXY=

# --- Tunables (defaults shown) ---
# WEATHER_API_BASE=https://weather.googleapis.com
# GEOCODING_API_BASE=https://geocoding-api.open-meteo.com
# Keyless reverse geocoding (coordinates -> place name) for devices whose
# platform Geocoder has no backend. Privacy note: reverse-geocode queries
# send the device's coordinates to this third-party service.
# REVERSE_GEOCODING_API_BASE=https://api.bigdatacloud.net
# UPSTREAM_TIMEOUT_MS=8000
# UPSTREAM_RETRIES=2
# Base delay between retries (exponential with jitter): backoff * 2^attempt.
# UPSTREAM_RETRY_BACKOFF_MS=100
# Whole-request budget for one bundle fan-out (retries + backoff included).
# UPSTREAM_DEADLINE_MS=20000
# After this many consecutive failed calls an upstream endpoint fails fast
# for BREAKER_COOLDOWN_MS before one probe is allowed. 0 disables.
# BREAKER_FAILURES=5
# BREAKER_COOLDOWN_MS=30000
# CACHE_TTL_MS=600000
# Degraded bundles (a soft endpoint failed) are cached only this long.
# DEGRADED_CACHE_TTL_MS=30000
# Alerts are served near-fresh: microcached this long so a storm-time herd
# shares one upstream call per place without staling warnings.
# ALERTS_CACHE_TTL_MS=15000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=240
# WEATHER_RATE_LIMIT_MAX=120
# GEOCODE_RATE_LIMIT_MAX=30
# DEVICE_RATE_LIMIT_MAX=20
# MAX_DEVICES=25000
# DATA_DIR=data
# LOG_LEVEL=debug
